# Copie para .env e preencha. O .env nunca vai para o Git (constituição, princípio VI).

# Nome do banco criado pelo container do PostgreSQL.
POSTGRES_DB=jumplab
# Usuário dono do banco no container do PostgreSQL.
POSTGRES_USER=
# Senha desse usuário. Gere uma forte; não reaproveite de outro sistema.
POSTGRES_PASSWORD=

# URL JDBC que a API usa. No compose, o host é o nome do serviço: jdbc:postgresql://postgres:5432/jumplab
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/jumplab
# Usuário do banco para a API (o mesmo de POSTGRES_USER no ambiente local).
SPRING_DATASOURCE_USERNAME=
# Senha do banco para a API (a mesma de POSTGRES_PASSWORD no ambiente local).
SPRING_DATASOURCE_PASSWORD=

# Segredo que assina os tokens de acesso (HS256). Pelo menos 32 bytes; gere com: openssl rand -base64 48
JUMPLAB_JWT_SEGREDO=
# Validade do token de acesso, em minutos (D15: 15).
JUMPLAB_JWT_ACESSO_MINUTOS=15
# Validade do token de renovação, em dias (D15: 30).
JUMPLAB_JWT_RENOVACAO_DIAS=30
